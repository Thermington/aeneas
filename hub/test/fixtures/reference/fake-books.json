   "Blueman": {
    "title": "Blueman",
    "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Blueman</title><script>window.RLQ = [];</script><link rel=\"stylesheet\" href=\"./_mw_/site.css\"></head><body><main id=\"content\"><h1 id=\"firstHeading\">Blueman</h1><div id=\"mw-content-text\"><div class=\"mw-parser-output\"><p>Blueman is a full featured Bluetooth manager. It can connect a headset.</p></div><div id=\"catlinks\" class=\"catlinks\">Categories: <a href=\"Category%3ASound\">Sound</a></div></div></main></body></html>"
   },
   "Systemd/User": {
